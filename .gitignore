# ml-service training: raw data and run outputs stay out of git (upload data as a Kaggle dataset)
# Only the folder skeleton (README.md and .gitkeep files) under ml-service/data is tracked.
ml-service/data/**
!ml-service/data/**/
!ml-service/data/README.md
!ml-service/data/**/.gitkeep
# Run outputs: only the small result files (tables, json reports, curve images) are tracked so results can be pulled and read.
# Stored scores, model checkpoints and arrays stay out. Later rules win, so the exclusions come last.
ml-service/artifacts/**
!ml-service/artifacts/**/
!ml-service/artifacts/**/*.md
!ml-service/artifacts/**/*.json
!ml-service/artifacts/**/*.png
ml-service/artifacts/**/scores/**
ml-service/artifacts/**/checkpoints/**
ml-service/artifacts/**/*.pt
ml-service/artifacts/**/*.npz
ml-service/artifacts/**/*.npy
ml-service/*.nc
*.nc


# notebooks with credentials written into them
*.local.ipynb

# GRIB downloads (kept out of git)
*.grib
*.grib.part
*.idx
