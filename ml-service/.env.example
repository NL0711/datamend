# Copy this file to ml-service/.env and fill it in. `.env` is ignored by git;
# never commit a real token.

# CEDA access token, used by scripts/download_midas.py to download UK MIDAS Open data.
# Create a free account and generate a token at https://services.ceda.ac.uk/account/token/
# Tokens expire after a few days; generate a new one when the script says it was rejected.
CEDA_TOKEN=

# Kaggle credentials, used by scripts/fetch_rf25.py and scripts/run_qc.py to download the RF25 dataset
# (nathashalewis/majorproj-rainfall). Even a PUBLIC dataset needs a login through the API.
# Create a token at Kaggle -> Settings -> API -> Create New Token, then use ONE of these two forms:
#   new-style token (starts with KGAT_):
KAGGLE_API_TOKEN=
#   or the older username + key pair:
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Optional. Where datasets live. The MIDAS download goes to
# $DATAMEND_DATA_DIR/midas-open/uk-daily-rain-obs (default: ml-service/data/...).
# DATAMEND_DATA_DIR=
