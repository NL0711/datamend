# Copy this file to ml-service/.env and fill it in. `.env` is ignored by git;
# never commit a real token.

# CEDA access token, used by scripts/download_midas.py to download UK MIDAS Open data.
# Create a free account and generate a token at https://services.ceda.ac.uk/account/token/
# Tokens expire after a few days; generate a new one when the script says it was rejected.
CEDA_TOKEN=

# Optional. Where datasets live. The ERA5 download goes to $DATAMEND_DATA_DIR/era5. The MIDAS download goes to
# $DATAMEND_DATA_DIR/midas-open/uk-daily-rain-obs (default: ml-service/data/...).
# DATAMEND_DATA_DIR=

# Copernicus Climate Data Store key, used by scripts/download_era5.py to download ERA5 (temperature,
# dewpoint, surface pressure). Create a free account at https://cds.climate.copernicus.eu, copy the key
# from your profile page, and accept the ERA5 single-levels licence once on the dataset's Download tab.
# Keep it out of git; regenerate it on the profile page if it is ever exposed.
CDSAPI_KEY=
