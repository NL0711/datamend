# DataMend MCP service. Copy to mcp-service/.env (or export in your shell). Real secrets go in the untracked file only.

# --- how the MCP server reaches the DataMend platform (its REST API) ---
DATAMEND_BASE_URL="http://localhost:8000"
# PREFERRED: the platform's EVIDENCE_API_TOKEN, a read-only credential (GET under /api/validation/ and /api/places/ only). When set it is
# used and the admin credentials below are not needed or sent.
DATAMEND_READ_TOKEN=""
# Otherwise use ONE of these (wider access than this server needs). The token is the platform's ADMIN_TOKEN; or the admin sign-in (ADMIN_EMAIL / ADMIN_PASSWORD of the platform).
DATAMEND_ADMIN_TOKEN=""
DATAMEND_ADMIN_EMAIL=""
DATAMEND_ADMIN_PASSWORD=""

# --- the MCP server over HTTP (stdio needs none of this) ---
MCP_HTTP_HOST="127.0.0.1"
MCP_HTTP_PORT=8765
# Required for HTTP. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_BEARER_TOKEN=""
MCP_ALLOWED_ORIGINS=""            # comma list of browser origins; empty = none
MCP_RATE_PER_MINUTE=120
MCP_AUDIT_LOG="data/mcp_audit.jsonl"
MCP_ENFORCE_MANIFEST=true         # refuse to serve a tool whose definition differs from tool_manifest.lock.json

# --- the narrator service (the platform's NARRATOR_URL points here) ---
NARRATOR_HOST="127.0.0.1"
NARRATOR_PORT=8790
# Must equal the platform's NARRATOR_TOKEN. Empty = no auth (local demo only).
NARRATOR_BEARER_TOKEN=""
# Empty = start the MCP server as a child process (stdio). Or point at a running HTTP MCP server:
NARRATOR_MCP_URL=""
NARRATOR_MCP_TOKEN=""
NARRATOR_MAX_TOOL_STEPS=6
# Empty = grounded mode (no language model). Set a key to turn on LLM mode.
ANTHROPIC_API_KEY=""
NARRATOR_LLM_MODEL="claude-sonnet-5-5"
