FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
# No torch, scikit-learn or other ML packages: the platform is rules, a gamma tail (scipy) and a neighbour check.
RUN pip install --no-cache-dir -r requirements.txt
# The agent (S6) packages: without them the platform runs and /api/agent is simply absent. Adds about 60 MB of memory (measured on Windows, import only).
COPY backend/requirements-agent.txt ./requirements-agent.txt
RUN pip install --no-cache-dir -r requirements-agent.txt

COPY backend/ ./backend/
# The platform's own MCP endpoint (POST /api/mcp) hosts the standard-library MCP server of mcp-service: its package and the pinned tool lock.
COPY mcp-service/datamend_mcp ./mcp-service/datamend_mcp
COPY mcp-service/tool_manifest.lock.json ./mcp-service/tool_manifest.lock.json
# The place lookup reads the committed land/region map of the RF25 grid (one small JSON file, nothing else from ml-service).
COPY ml-service/qc/assets/client_map.json ./ml-service/qc/assets/client_map.json

# Recorded in every run so a result can be traced to a build: docker build --build-arg GIT_COMMIT=$(git rev-parse HEAD) ...
ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=${GIT_COMMIT}
ENV PYTHONPATH=/app

EXPOSE 8000

# Render/Railway inject $PORT; fall back to 8000 locally
CMD ["sh", "-c", "uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
