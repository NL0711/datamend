# DataMend environment configuration. Copy to .env and edit; .env is never committed. Real secrets (keys, tokens) go in .env only.
PROJECT_NAME="DataMend"
VERSION="0.2.0"
DEBUG=True

# Backend server and networking (CORS_ORIGINS is a JSON list)
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5199","http://127.0.0.1:5199","http://localhost:3000"]

# Database. Default: local SQLite, no server needed. On a free Render tier SQLite resets on restart ("demo storage"); the JSON export
# of a run is the durable copy. PostgreSQL / Tiger Cloud (Timescale): paste the host's string as it is (postgres://user:password@host:port/db?sslmode=require);
# it is converted to postgresql+asyncpg:// at start-up. The tables are created at start-up (no migrations). The Timescale hypertable step
# is UNTESTED against a live service. Keep the real string in your .env or the host's environment only.
DATABASE_URL="sqlite+aiosqlite:///./datamend.db"

# Weather Union live rain-gauge feed (free key from https://www.weatherunion.com/dashboard/).
# Put the real key in your local .env only, never in this file.
WEATHER_UNION_BASE_URL="https://www.weatherunion.com/gw/weather/external/v0"
WEATHER_UNION_API_KEY="your_weather_union_api_key"
# The feed is OFF unless both the key and a city are set. It polls the N stations closest to the city centre.
WEATHER_UNION_CITY=""                       # e.g. "Mumbai" (see backend/app/rainfall/data/weather_union_stations.csv)
WEATHER_UNION_MAX_STATIONS=9                # 9 stations x 96 polls/day = 864 calls; the free key allows 1000/day
WEATHER_UNION_POLL_INTERVAL_SECONDS=900     # raised automatically if the budget would be exceeded
WEATHER_UNION_DAILY_CALL_BUDGET=900
# The provider does not document rain_accumulation: "cumulative" (running total) or "per_reading" (amount since last reading).
WEATHER_UNION_ACCUMULATION_MODE="cumulative"
WEATHER_UNION_RAW_LOG_PATH="data/weather_union_raw.jsonl"

# Import step (Amazon S3 link or Kaggle dataset): no setting is needed. A PUBLIC Kaggle dataset or S3 bucket imports with no credentials at all.
# For a private Kaggle dataset the page asks the visitor for an API token (the token only, no username); it is sent for that request and never
# stored. Optionally set a server-side token as the fallback (Kaggle: Settings > API > Create New Token). NOAA ISD files (non-US data, WMO
# Resolution 40) are imported from an S3 link at run time and never committed or redistributed.
KAGGLE_API_TOKEN=""

# Bulk ingest: where uploaded files wait while a job reads them (a temp folder by default; on Render the disk is cleared on restart).
PIPELINE_UPLOAD_DIR=""

# Kaggle retraining (optional): your Kaggle account, to run the label-fusion training as a private notebook. Needs `pip install kaggle` on the server.
# Put the real key in your local .env or the host's environment only, never in this file.
KAGGLE_USERNAME=""
KAGGLE_KEY=""

# AWS retraining (optional, UNTESTED against live AWS): runs the label-fusion training on one short-lived EC2 instance in YOUR account; AWS bills you.
# Needs `pip install boto3` on the server. Region and S3 bucket (in that region) are the defaults when a request brings none. The credentials come from
# the server's environment (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, optionally AWS_SESSION_TOKEN), never from this file; a visitor may bring their own.
AWS_REGION="ap-southeast-2"
AWS_TRAIN_BUCKET=""

# AI narrator (the AI team's service). Empty = "AI narrator not connected"; the rule-based baseline explanation still works.
# The URL is read from the environment only (the UI never sets it). Put the real token in your local .env only.
NARRATOR_URL=""
NARRATOR_TOKEN=""
NARRATOR_TIMEOUT_SECONDS=20
# A narrator on localhost or a private network is refused when set from the dashboard unless you opt in here.
NARRATOR_ALLOW_PRIVATE=false

# A READ-ONLY credential for an external reader such as the MCP server: sent as "Authorization: Bearer <token>", accepted only for GET under
# /api/validation/ and /api/places/, never for a write or another route. Empty = off. A long random string, different from ADMIN_TOKEN.
EVIDENCE_API_TOKEN=""

# Interim LLM layer on Google Gemini, used while NARRATOR_URL is empty (a set NARRATOR_URL wins). Local .env only; never commit a real key.
# Only the evidence payload is sent. Check Google's current model list before relying on the default model id.
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.5-flash-lite
# Live test: gemini-3.5-flash-lite answered explain, chat and propose in 5 to 6 s each; gemini-3.5-flash took 22 to 56 s and once ran out of tokens while thinking.
GEMINI_TIMEOUT_SECONDS=90
GEMINI_CALLS_PER_MINUTE=10
GEMINI_DAILY_CALL_BUDGET=200

# Sign-in. With REQUIRE_LOGIN=true (the default) every /api route except /api/auth/login, /me and /logout needs a signed-in session.
REQUIRE_LOGIN=true
# The one admin account. These defaults are for LOCAL USE ONLY: anyone who knows them can sign in. On any public deployment (Render) set
# your own ADMIN_EMAIL and a long ADMIN_PASSWORD. Sessions are kept in memory and end when the server restarts.
# An empty ADMIN_PASSWORD switches the sign-in off (and, with no ADMIN_TOKEN, editing too).
ADMIN_EMAIL="admin@admin.com"
ADMIN_PASSWORD="admin"
# Optional token for scripts: send it as the X-Admin-Token header instead of a session. Anyone holding it can use and edit everything.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"   Keep it in .env only.
ADMIN_TOKEN=""
# Where dashboard-saved settings are kept (they override this file; git-ignored; contains secrets, keep it private).
RUNTIME_SETTINGS_PATH="data/runtime_settings.json"
